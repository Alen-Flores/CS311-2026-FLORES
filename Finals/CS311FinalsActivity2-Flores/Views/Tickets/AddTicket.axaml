<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CS311_CS3A_2026_Flores.ViewModels"
             xmlns:model="using:CS311_CS3A_2026_Flores.Models"
             x:DataType="vm:AddTicketViewModel"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="CS311_CS3A_2026_Flores.Views.AddTicket">
  <Grid ColumnDefinitions="auto,*"
        RowDefinitions="auto,auto,auto,auto"
        RowSpacing="20" ColumnSpacing="15"
        >
    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
               Text="Ticket Number:" />
    <TextBox Grid.Row="0" Grid.Column="1" IsReadOnly="True"
             Text="{Binding TicketNumber}" />
    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
               Text="Problem:" />
    <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
              ItemsSource="{x:Static model:Ticket.ProblemTypes}"
              SelectedItem="{Binding Problem}"
              />
    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
               Text="Details:" />
    <TextBox Grid.Row="2" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
             MinLines="4" Width="300" Text="{Binding Details}"  />
      
      <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
        Orientation="Horizontal" HorizontalAlignment="Right" Margin="30,10" Spacing="10">
      <Button MinWidth="100" HorizontalContentAlignment="Center"
        Content="Save" Command="{Binding SaveCommand}" />
      <Button MinWidth="100" HorizontalContentAlignment="Center"
        Content="Cancel" Command="{Binding CancelCommand}" />
    </StackPanel>
  </Grid>
</UserControl>
