<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CS311_CS3A_2026_Flores.Views.Dialog"
        Title="" Width="300" Height="150"
        WindowStartupLocation="CenterOwner"
        KeyDown="onDialog_KeyDown"
        xmlns:vm="using:CS311_CS3A_2026_Flores.Views"
        x:DataType="vm:Dialog"
        > 
        <StackPanel Margin="20" Spacing="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <TextBlock 
            x:Name="txtMessage"
            Text="" TextWrapping="Wrap"
            />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Yes" 
            IsVisible="{Binding ShowYes}" 
            Command="{Binding SelectResultCommand}"
            CommandParameter="{x:Static vm:Dialog+DialogResult.Yes}"
            />
            <Button Content="No" 
            IsVisible="{Binding ShowNo}" 
            Command="{Binding SelectResultCommand}"
            CommandParameter="{x:Static vm:Dialog+DialogResult.No}"
            />
            <Button Content="Ok" 
            IsVisible="{Binding ShowOk}" 
            Command="{Binding SelectResultCommand}"
            CommandParameter="{x:Static vm:Dialog+DialogResult.Ok}"
            />
            
        </StackPanel>
    </StackPanel>
</Window>
