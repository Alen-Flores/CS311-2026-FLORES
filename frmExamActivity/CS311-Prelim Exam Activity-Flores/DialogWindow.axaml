<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CS311_Prelim_Exam_Activity_Flores.DialogWindow"
        Title="Confirmation" Width="300" Height="150"
        WindowStartupLocation="CenterOwner"> 
        <StackPanel Margin="20" Spacing="20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <TextBlock 
            x:Name="txtMessage"
            Text="Are you sure you want to delete this item?" />

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Ok" Click="OnOkClick" Width="60"/>
        </StackPanel>
    </StackPanel>
</Window>